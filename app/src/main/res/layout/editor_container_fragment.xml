<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="45dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tablayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:gravity="start"
            app:tabIndicator="@drawable/tab_indicator"
            app:tabIndicatorColor="?attr/colorPrimary"
            app:tabIndicatorFullWidth="false"
            app:tabInlineLabel="true"
            app:tabMode="scrollable"
            app:tabGravity="start"
          />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/editor_ai_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
                <TextView android:id="@+id/editor_ai_messages" android:layout_width="match_parent" android:layout_height="80dp" android:text="AI: أنا داخل مشروعك الآن. أخبرني بما تريد تغييره." android:textIsSelectable="true" android:textSize="13sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <EditText android:id="@+id/editor_ai_input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="اطلب تعديلاً على الملف المفتوح…" android:inputType="textMultiLine" android:maxLines="3" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/editor_ai_send" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="إرسال" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/editor_ai_propose" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="اقتراح تعديل" style="@style/Widget.Material3.Button.OutlinedButton" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/editor_ai_rollback" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="تراجع" android:visibility="gone" style="@style/Widget.Material3.Button.TextButton" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/editor_ai_audit" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="فحص المشروع بالكامل" style="@style/Widget.Material3.Button.TextButton" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout android:id="@+id/editor_ai_bar" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp">
            <TextView android:id="@+id/editor_ai_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Project AI · مساعد المشروع" android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton android:id="@+id/editor_ai_toggle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="دردشة AI" style="@style/Widget.Material3.Button.TextButton" />
            <com.google.android.material.button.MaterialButton android:id="@+id/editor_ai_preview" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="معاينة" app:icon="@drawable/ic_android" app:iconGravity="textStart" style="@style/Widget.Material3.Button.TextButton" />
        </LinearLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewpager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/persistent_sheet"
        android:name="com.tyron.code.ui.editor.BottomEditorFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:elevation="4dp"
        app:behavior_peekHeight="45dp"
        app:behavior_hideable="false"
        app:layout_behavior="@string/bottom_sheet_behavior"
        tools:layout="@layout/bottom_editor_fragment" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
